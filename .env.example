# Copy to .env and replace every placeholder. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=gradnexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gradnexa

# --- Backend ---
# 'production' enforces safe settings at startup (strong SECRET_KEY, rate limiting on, bcrypt >= 10,
# no wildcard CORS) and disables /docs. docker-compose.yml sets this for you.
ENVIRONMENT=development
BCRYPT_ROUNDS=12
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
# Local (non-docker) run; compose overrides this to point at the db service
DATABASE_URL=postgresql://gradnexa:change-me@localhost:5432/gradnexa
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Same-origin deployments through the bundled nginx need no CORS; list extra origins here.
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- SMTP (password reset / notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- LLM (later phases) ---
LLM_PROVIDER=
LLM_API_KEY=

# --- Frontend (build-time) ---
# Leave EMPTY for docker compose (same origin via nginx). For `npm run dev` use http://127.0.0.1:8000
VITE_API_URL=
FRONTEND_PORT=80
